# Copy to .env (gitignored) and fill in locally if you want the optional providers.
# AI Command Center starts and works fully without any of these set.

# Optional: enables the OpenAI provider on the Project Chat page (Responses API).
# Billed separately from a ChatGPT subscription. Absent -> that provider is simply
# reported unavailable in the UI; local/manual mode and Claude Code keep working.
OPENAI_API_KEY=
# Required alongside OPENAI_API_KEY — the model name is never hard-coded in code.
OPENAI_MODEL=

# Optional: override the Claude Code CLI model used by the runner and chat provider
# (e.g. "sonnet", "opus", or a full model id). Unset uses the CLI's own default.
CLAUDE_CODE_MODEL=

# Advanced/testing only: redirect ALL runtime storage (tasks/runs/chats/activity/
# project config) to a different directory instead of ./data. The test suite uses
# this to guarantee it never reads or writes your real local data.
AICC_DATA_DIR=

# Path to the master backlog markdown projection (command_center/backlog_client.py,
# VOYN-W0-BACKLOG-ORCHESTRATOR BO-S4). The console's Master Backlog panel reads this
# file; on a server install, `aicc-backlog-export.timer` writes it from the
# canonical `backlog_task` store every 5 minutes
# (deploy/systemd/aicc-backlog-export.service). Unset yields an empty-but-usable
# projection ("backlog not connected"), never an error.
AICC_MASTER_BACKLOG=

# ---------------------------------------------------------------------------
# PostgreSQL server deployment (VOYN-W0-AICC-SRV-01a). Only needed for a server
# install; the desktop and CLI paths ignore all of these.
# See docs/postgres-foundation.md.
#
# Generate every secret uniquely, e.g. `openssl rand -base64 32`. Startup
# rejects well-known defaults, anything under 16 characters, and a password
# equal to the user name.
# ---------------------------------------------------------------------------

# Superuser for docker-compose.server.yml. Used once for `bootstrap`, never by
# the running application.
AICC_PG_SUPERUSER=
AICC_PG_SUPERUSER_PASSWORD=

# Application connection. AICC_PG_USER is one of aicc_migrator / aicc_app /
# aicc_worker depending on which process is starting.
AICC_PG_HOST=127.0.0.1
AICC_PG_PORT=5432
AICC_PG_DB=aicc
AICC_PG_USER=
AICC_PG_PASSWORD=

# TLS. Defaults to verify-full; a non-verifying mode is accepted only when the
# host is a loopback address (the single-host compose deployment).
AICC_PG_SSLMODE=
AICC_PG_SSLROOTCERT=

# Pool sizing and timeouts. Defaults: 1 / 10 / 10s / 30000ms.
AICC_PG_POOL_MIN=
AICC_PG_POOL_MAX=
AICC_PG_POOL_TIMEOUT=
AICC_PG_STATEMENT_TIMEOUT_MS=

# ---------------------------------------------------------------------------
# HTTP authentication for the mutating API surfaces (VOYN-W0-AICC-AUTH-HTTP-01)
# ---------------------------------------------------------------------------

# Base URL of the platform that owns identity. AICC forwards the caller's own
# bearer credential to <this>/api/v1/whoami and takes the reflected principal id
# as the caller's identity; it stores no credential of its own. Unset means this
# deployment cannot authenticate anyone, so every mutating request answers 503 —
# never an implicit allow.
AICC_PLATFORM_URL=

# Path to the JSON grant map: {"<principal_id>": ["<operation>", ...]}. The
# operation names are the closed inventory in
# command_center/http_auth/authz.py:OPERATIONS; an unrecognised name refuses to
# load rather than silently never matching. Unset or absent is an empty map,
# which denies everyone — authentication is delegated to the platform, but
# authorization is AICC's own and deny-by-default, because a valid platform
# credential proves nothing about AICC.
AICC_HTTP_GRANTS_FILE=
