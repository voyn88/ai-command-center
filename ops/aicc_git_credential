#!/bin/sh
# git credential helper for the isolated worker lanes (installed as
# /usr/local/libexec/aicc-git-credential, wired through /etc/aicc/gitconfig).
# Answers github.com with the GitHub App installation token that
# voyn-aicc-github-token.timer stores in /var/lib/aicc/github/token
# (0640 root:aicc-worker). Never stores, never erases, answers nothing else.
case "$1" in get) ;; *) exit 0;; esac
host=""
while IFS== read -r key value; do
  [ "$key" = host ] && host="$value"
done
[ "$host" = github.com ] || exit 0
token=$(head -c 1024 /var/lib/aicc/github/token 2>/dev/null | tr -d "\n") || exit 0
[ -n "$token" ] || exit 0
printf "protocol=https\nhost=github.com\nusername=x-access-token\npassword=%s\n" "$token"
