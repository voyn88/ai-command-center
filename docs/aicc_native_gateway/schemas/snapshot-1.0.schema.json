    "AgentLaneDTO": {
      "additionalProperties": false,
      "properties": {
        "heartbeatAgeSeconds": {
          "title": "Heartbeatageseconds",
          "type": "integer"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "state": {
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "id",
        "state",
        "heartbeatAgeSeconds"
      ],
      "title": "AgentLaneDTO",
      "type": "object"
    },
    "ConnectionDTO": {
      "additionalProperties": false,
      "description": "Additive in DTO 1.0 \u2014 how live the projection behind this response is.",
      "properties": {
        "projectionAgeSeconds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
