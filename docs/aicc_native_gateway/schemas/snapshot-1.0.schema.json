        "acceptance": {
          "$ref": "#/$defs/EvidenceState",
          "default": "unknown"
        },
        "ci": {
          "$ref": "#/$defs/EvidenceState",
          "default": "unknown"
        },
        "deployedSHA": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deployedsha"
