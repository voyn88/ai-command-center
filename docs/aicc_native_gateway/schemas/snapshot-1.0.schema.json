    "EvidenceState": {
      "enum": [
        "unknown",
        "observed",
        "verified",
        "rejected",
        "pending"
      ],
      "title": "EvidenceState",
      "type": "string"
    },
    "Freshness": {
      "enum": [
        "fresh",
        "stale",
        "offline",
        "degraded"
