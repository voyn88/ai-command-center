<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Publishes the canonical backlog into the control plane's structured store.

  StartInterval rather than KeepAlive: this is a periodic reconciliation, not
  a daemon. Each run is a complete publish that either lands or fails loudly,
  so a crashed run must not be restarted instantly in a tight loop. The next
  interval is soon enough, and a permanent failure then shows as a repeating
  log line rather than a spinning process.

  Five minutes matches the control plane's own tick interval (planner, review,
  merge, reaper): a task recorded here is visible to the very next tick, and
  the store is never more than one tick behind the file. The import is
  idempotent, so a run with nothing to do reports `unchanged` and costs one
  ssh round trip.

  This job is one half of a deliberately temporary bidirectional bridge
  (VOYN-W0-BACKLOG-ORCHESTRATOR BO-S4): the store also exports back to a
  markdown projection, in a different record shape, on
  `aicc-backlog-export.timer`, so readers of that file stay current without
  the owner touching it. This plist, the script it runs
  (ops/aicc_backlog_publish.py) and the backlog-import command are the side
  that retires (not deprecated, not feature-flagged, deleted outright) once
  the revisit condition in
  docs/adr/0011-backlog-projection-bidirectional-bridge.md is met, or by its
  2026-11-01 target date at the latest.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ai-command-center.backlog-publish</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>__ROOT__/ops/aicc_backlog_publish.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__ROOT__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__ROOT__/data/backlog-publish.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__ROOT__/data/backlog-publish.stderr.log</string>
</dict>
</plist>
