# Host-local settings for the self-care timers (voyn-ops-disk-guard,
# voyn-ops-beacon, voyn-ops-self-heal).  The installer writes the real file to
# /etc/aicc/ops-autonomy.env on each host; this template documents every key.
# Every absolute path and every owner-specific name belongs HERE, never in the
# repository (it is public).
#
# worker | control -- names the status branch (ops-status-<role>) only.
OPS_HOST_ROLE=worker

# --- disk guard -----------------------------------------------------------
# 1 = only journal what would be deleted.  The installer's --live flips this.
OPS_DISK_GUARD_DRY_RUN=1
OPS_DISK_PATH=/
# act when free space is below this percentage ...
OPS_DISK_LOW_FREE_PCT=15
# ... and stop once this much would be free
OPS_DISK_TARGET_FREE_PCT=25
# a task clone is eligible only when its PR has been merged/closed this long
OPS_CLONE_MIN_AGE_DAYS=3
# colon-separated absolute paths; clones are removed only as DIRECT children
OPS_CLONE_ROOTS=
# colon-separated cache directories whose CONTENT may be cleared
OPS_CACHE_DIRS=
# model server directory containing manifests/ and blobs/ (orphan blobs only)
OPS_OLLAMA_MODELS_DIR=
OPS_JOURNAL_MAX_MB=500
# per-run blast-radius caps
OPS_DISK_MAX_CLONES=25
OPS_DISK_MAX_GB=40

# --- status beacon ---------------------------------------------------------
OPS_BEACON_PUBLISH=1
OPS_STATUS_REPO=voyn88/ai-command-center
OPS_TUNNEL_PORT=17443

# --- self-heal -------------------------------------------------------------
OPS_SELF_HEAL_DRY_RUN=1
