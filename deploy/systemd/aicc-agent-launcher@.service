[Unit]
Description=AICC root-owned agent launcher connection %i
After=aicc-agent-launcher.socket

[Service]
Type=exec
ExecStart=/usr/libexec/aicc-agent-launcher --serve-socket
StandardInput=socket
StandardOutput=socket
StandardError=journal
User=root
Group=root
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
LockPersonality=yes
KeyringMode=private
RestrictAddressFamilies=AF_UNIX
# Every entry is declared in deploy/tmpfiles.d/aicc-agent.conf and the
# socket unit re-creates that declaration (systemd-tmpfiles --create) before
# it accepts the first connection: this namespace is built before ExecStart,
# so a path only the launcher creates refused the connection with
# 226/NAMESPACE (worker-01, 2026-09-08). Strict entries, deliberately: a
# '-' would only let the namespace come up around an ABSENT path, and a
# directory created afterwards never becomes writable inside it (review of
# 5736dd6c) -- the connection would fail one step later instead.
ReadWritePaths=/run/aicc-agent-launcher /run/aicc-agent-homes /run/aicc-agent-workspace-binds /srv/aicc-workspaces /srv/aicc-quarantine
UMask=0077
MemoryMax=256M
TasksMax=64
TimeoutStopSec=30s
