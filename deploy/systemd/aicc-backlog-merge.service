# The backlog merge tick (BO-S3b): the production caller of the merge
# cycle, beside the planner and the reaper.
#
# Install (control-plane host): the `control` profile of
# ops/aicc_install_transaction.py / deploy/install-agent-principal-isolation.sh
# (VOYN-W0-AICC-CONTROL-PLANE-REPO-OWNED-UNITS). Not a manual `cp`.
#
# Identity and paths mirror aicc-backlog-planner.service exactly: aicc-app,
# /etc/aicc/app.env, /opt/aicc/current (the release symlink -- there is no
# bare /opt/aicc/.venv, and no /srv/ai-command-center on either host).
# `--repo-path` is left at its default `.`, which resolves against
# WorkingDirectory; merge_once() drives everything through `gh`, so it needs
# no `.git` checkout there, only a directory to run in and
# GH_TOKEN/GITHUB_TOKEN from app.env for non-interactive auth.

[Unit]
Description=AICC backlog merge tick (BO-S3b)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=aicc-app
Group=aicc-app
EnvironmentFile=/etc/aicc/app.env
WorkingDirectory=/opt/aicc/current
ExecStart=/opt/aicc/current/.venv/bin/python -m command_center.db backlog-merge
TimeoutStartSec=120s

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
