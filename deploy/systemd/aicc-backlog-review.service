[Unit]
Description=AICC backlog review tick (BO-S3b)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=aicc-app
Group=aicc-app
EnvironmentFile=/etc/aicc/app.env
WorkingDirectory=/opt/aicc
ExecStart=/opt/aicc/.venv/bin/python -m command_center.db backlog-review --repo-path /opt/aicc
TimeoutStartSec=180s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
