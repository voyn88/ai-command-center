# Self-heal: restarts tailscaled / ssh / allow-listed voyn-aicc-* units on
# clear, twice-confirmed signs of a hang (see command_center/ops/self_heal.py
# for the rules: cool-down, hourly cap, deny-list).  Dry run by default.
[Unit]
Description=VOYN host self-heal (dry run unless the host settings say live)
After=local-fs.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/aicc/current
ExecStart=/opt/aicc/current/.venv/bin/python -m command_center.ops.self_heal
TimeoutStartSec=3min
Nice=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/voyn-ops /var/log/voyn-ops
# Security review M1: uid 0 is needed only so systemd accepts `systemctl
# restart`; the capability set is cut to what `ss -p` needs to name the holder
# of the review port (read other accounts' processes).  No file, mount,
# network-admin or module capability remains.
CapabilityBoundingSet=CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
AmbientCapabilities=
PrivateDevices=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
