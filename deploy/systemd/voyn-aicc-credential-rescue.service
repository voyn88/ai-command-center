[Unit]
Description=AICC bounded rescue for expired worker database credentials
After=network-online.target postgresql@16-main.service
Wants=network-online.target

[Service]
Type=oneshot
User=voynadmin
WorkingDirectory=/opt/aicc/current
# pragma: allowlist nextline secret -- a path, flagged as high-entropy
Environment=AICC_PREPROD_ROOT=/home/voynadmin/aicc-preprod
ExecStart=/bin/bash -lc "set -a && source ${AICC_PREPROD_ROOT}/.env && set +a && exec /opt/aicc/current/.venv/bin/python -m command_center.ops.credential_rescue"
TimeoutStartSec=900s
NoNewPrivileges=true
PrivateTmp=true
