[Unit]
Description=Schedule AICC worker credential rotation

[Timer]
OnBootSec=2min
# Cadence starts after the previous rotation completes, so a slow bounded
# recovery cannot cause an immediate queued second rotation. The tick is a
# cheap check, not a rotation: the controller rotates only once the
# credential's remaining lifetime is at or below --rotation-threshold and
# otherwise exits with rotation_deferred_not_due. Eight minutes gives a tick
# that is lost for any reason two more chances inside the one-hour credential
# (at 25 minutes a single lost tick left no margin: worker-01, 2026-11-10).
OnUnitInactiveSec=8min
RandomizedDelaySec=60s
AccuracySec=15s
Unit=voyn-aicc-credential-rotation.service

[Install]
WantedBy=timers.target
