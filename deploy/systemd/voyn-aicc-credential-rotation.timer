[Unit]
Description=Schedule AICC worker credential rotation

[Timer]
OnBootSec=2min
# Cadence starts after the previous rotation completes, so a slow bounded
# recovery cannot cause an immediate queued second rotation.
OnUnitInactiveSec=15min
RandomizedDelaySec=60s
AccuracySec=15s
Persistent=true
Unit=voyn-aicc-credential-rotation.service

[Install]
WantedBy=timers.target
