# The headless worker under systemd (VOYN-W0-AICC-SRV-05).
#
# Install:
#   cp deploy/systemd/aicc-worker.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now aicc-worker
#
# The unit assumes the host is already enrolled: /etc/aicc/worker.env carries
# AICC_PG_USER=<its aicc_w_* role> and the SCRAM secret produced at ticket
# redemption. Enrolment is an operator act — a worker cannot redeem its own
# ticket by design.

[Unit]
Description=AI Command Center headless worker
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
# The daemon sends READY=1 when its claim loop starts and feeds the watchdog
# from the claim loop between claims and from a dedicated ticker thread for
# exactly the length of a handler's run, so every healthy state pings within
# one tick (visibility/3 = 100s by default). Two consecutive missed pings mean
# the process is wedged, and restart is safe by the same construction as
# SIGKILL: lease expiry plus the reaper timer (aicc-queue-reaper.timer) resume
# the item elsewhere. 240s = two ticks plus slack.
#
# This value is NOT a run-length budget, and must not be raised to cover one
# (VOYN-W0-AICC-WATCHDOG-KILLS-REAL-RUNS). Runs here are agent sessions of
# 5-30+ minutes; the ticker pings straight through them, including through a
# lost lease and an unreachable database, because liveness asks "is this
# process alive" and nothing else. A run that outlives WatchdogSec is not the
# failure mode this deadline is for — a run's own timeout_seconds bounds it.
WatchdogSec=240s
User=aicc-worker
Group=aicc-worker
EnvironmentFile=/etc/aicc/worker.env
WorkingDirectory=/opt/aicc
ExecStart=/opt/aicc/.venv/bin/python -m command_center.worker

# Exit codes are the daemon's interface: 2 = config refused (an operator's
# problem — restarting cannot cure a bad env file, so it is excluded from
# restart), 3 = DB unreachable (cured by time).
Restart=always
RestartSec=10s
RestartPreventExitStatus=2
# SIGTERM stops claiming and finishes the item in hand. The stop timeout
# outlives ONE visibility window — a handler that finishes within its first
# lease survives shutdown intact. A longer-running handler (heartbeats exist
# so they may) is abandoned at the timeout; that abandonment is safe by
# construction (reaper + stale-owner fence), it is just not free: the item
# re-runs elsewhere.
TimeoutStopSec=330s

# Containment: the worker executes claimed payloads and talks to PostgreSQL —
# nothing here needs privileges, a home, or a writable system.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
StateDirectory=aicc-worker
# Resource envelope (SRV-05): declared limits, enforced by cgroups — which,
# unlike the mount/network sandbox directives, apply for user units too.
# Acceptance of the *sandbox* directives is measurement-from-inside per
# SRV-05-B and deliberately not claimed here.
MemoryMax=6G
MemoryHigh=5G
CPUQuota=300%
TasksMax=512

[Install]
WantedBy=multi-user.target
