# Versioned two-lane worker template for VOYN pre-production.
[Unit]
Description=AICC preprod worker lane %i
After=network-online.target voyn-aicc-pgtunnel.service
Wants=network-online.target
Requires=voyn-aicc-pgtunnel.service

[Service]
# Type=notify-reload makes `systemctl reload` wait until the daemon has
# finished its current attempt, replaced its PostgreSQL pool, authenticated
# with the new credential and sent READY=1.
Type=notify-reload
NotifyAccess=main
WatchdogSec=240s
User=aicc-worker
Group=aicc-worker
WorkingDirectory=/opt/aicc/current
LoadCredential=voyn_lease_pgpass:/etc/voyn/secrets/voyn_lease_pgpass
# All lane credentials live below one stable tree.  This is both scalable for
# arbitrary lane counts and lets transient agents mask the authority root once
# instead of maintaining an unsafe per-lane path list.
# `aicc-worker-lanes`, not the legacy `voyn-aicc-worker`: the staged rollout
# keeps legacy lanes (User=voynadmin, legacy runtime root voyn-aicc-worker)
# running while the first isolated lane starts, and the legacy unit owns
# that root 0750 voynadmin, so an aicc-worker lane nested under it
# died at ExecStartPre with "cannot stat ... Permission denied" (worker-01,
# 2026-09-08). A distinct runtime root is created by systemd for this unit's
# own principal and never collides with a lane of the other generation.
RuntimeDirectory=aicc-worker-lanes/%i
RuntimeDirectoryMode=0750
Environment=PGPASSFILE=/run/aicc-worker-lanes/%i/pgpass
# Mutable runtime data (project_config.json and the other data/*.json the
# control plane's modules resolve through storage.resolve_data_dir) lives
# OUTSIDE the immutable release: /opt/aicc/current is a read-only 0555 tree
# with no data/, so without this every lane read an empty config and every
# task failed with "repository path not configured" (worker-01, 2026-09-08,
# six hours after the first isolated rollout). All lanes share one state
# directory, as they shared one clone's data/ before.
StateDirectory=aicc/data
StateDirectoryMode=0750
Environment=AICC_DATA_DIR=/var/lib/aicc/data
# Root-owned system git config (safe.directory for the bound clone sources):
# a file, not GIT_CONFIG_COUNT/KEY/VALUE, because git's upload-pack child of
# a local clone does not inherit the environment form (worker-01 2026-09-08).
Environment=GIT_CONFIG_SYSTEM=/etc/aicc/gitconfig
# gh (the publisher's `gh pr create`) reads the installation token from this
# lane-only config dir; the AGENT's launcher points GH_CONFIG_DIR elsewhere,
# so untrusted model code never holds it. No prompts: a missing token is a
# legible failure, not a hang.
Environment=GH_CONFIG_DIR=/var/lib/aicc/github/gh
Environment=GIT_TERMINAL_PROMPT=0
Environment=AICC_WORKER_ENV_FILE=/var/lib/voyn-aicc-credential-rotation/worker.env
EnvironmentFile=/etc/aicc/lease.env
EnvironmentFile=/var/lib/voyn-aicc-credential-rotation/worker.env
EnvironmentFile=-/etc/aicc/executors.env
EnvironmentFile=-/etc/aicc/worker-%i.env
UnsetEnvironment=ANTHROPIC_API_KEY
# ADR-0010 invariant: the worker neither receives sudo nor selects a
# privileged command (review finding on 6218a21).
NoNewPrivileges=yes
# Prefer systemd's credential directory. Some privileged CI containers do not
# materialise LoadCredential= under %d; in that harness shape only, copy from
# the same root-only source path the credential loader would have used.
ExecStartPre=+/bin/sh -c 'src="${CREDENTIALS_DIRECTORY:-}/voyn_lease_pgpass"; [ -r "$src" ] || src=/etc/voyn/secrets/voyn_lease_pgpass; exec /usr/bin/install -o aicc-worker -g aicc-worker -m 0600 "$src" /run/aicc-worker-lanes/%i/pgpass'
# This final argv assignment cannot be overridden by EnvironmentFile values.
ExecStart=/opt/aicc/current/.venv/bin/python -m command_center.worker
ExecReload=/bin/kill -HUP $MAINPID

Restart=always
RestartSec=10s
RestartPreventExitStatus=2
# SIGTERM reaches only the daemon. Its child agent keeps running until the
# daemon exits naturally; only the final bounded kill reaches the cgroup.
KillMode=mixed
KillSignal=SIGTERM
FinalKillSignal=SIGKILL
SendSIGKILL=yes
TimeoutStopSec=3660s
TimeoutStartSec=195s

MemoryMax=6G
MemoryHigh=5G
CPUQuota=300%
TasksMax=512

[Install]
WantedBy=multi-user.target
