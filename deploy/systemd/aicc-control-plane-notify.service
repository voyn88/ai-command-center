[Unit]
Description=Deliver durable AICC control-plane owner alerts
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=aicc-app
Group=aicc-app
WorkingDirectory=/opt/aicc
EnvironmentFile=/etc/aicc/app.env
ExecStart=/opt/aicc/.venv/bin/python -m command_center.db control-plane-notify
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
LockPersonality=true
