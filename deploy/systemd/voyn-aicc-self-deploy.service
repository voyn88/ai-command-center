# Per-host self-deploy tick (VOYN-W0-AICC-DEPLOY-AUTOMATION).
#
# This is the CONTROL host variant: the database owner, so migrations run and
# no service is restarted (its ticks are oneshot units that re-exec from
# /opt/aicc/current on their next firing). The WORKER variant is a committed
# file of its own -- deploy/systemd/voyn-aicc-self-deploy-worker.service --
# and not a commented-out ExecStart in this header: the installer picks
# between the two by profile (`SELF_DEPLOY_UNIT_SOURCES`) and installs the
# chosen one as /etc/systemd/system/voyn-aicc-self-deploy.service. Before that
# existed, a host got this unit by an operator copying it and editing the line
# back in, which is how both hosts ended up running symlinks into a
# directory under the operator's home instead of anything in this repository
# (VOYN-W0-AICC-SYSTEMD-DRIFT-VERSIONED-UNITS).
#
# The command is fail-closed (diverged/dirty checkout, dependency-manifest
# change) and rolls back checkout + services on migration/smoke/restart
# failure; a non-zero exit marks the tick failed in systemd for the operator.
# `--branch` selects the remote branch when the default branch is not main.
[Unit]
Description=AICC per-host self-deploy tick (merged -> deployed)
After=network-online.target

[Service]
Type=oneshot
User=voynadmin
Environment=AICC_PREPROD_ROOT=/home/voynadmin/aicc-preprod
Environment=AICC_SOURCE_REPO=/home/voynadmin/aicc-preprod/repo
Environment=AICC_RUNTIME_VENV=/home/voynadmin/aicc-preprod/repo/.venv
WorkingDirectory=/opt/aicc/current
# Belt-and-suspenders alongside --rollout-lock (which self_deploy_once()
# checks and refuses on): a tick already queued when the staged rollout
# stops this unit's timer would otherwise still run to completion and race
# the rollout's own lane mutations (live 2026-09-08 worker-01;
# VOYN-W0-AICC-ROLLOUT-VS-ROTATE-SELFDEPLOY-TIMERS). A skipped
# ExecCondition is not a failure.
ExecCondition=/usr/bin/test ! -e /run/aicc-staged-rollout.lock
ExecStart=/bin/bash -lc "set -a && source ${AICC_PREPROD_ROOT}/.env && set +a && exec /opt/aicc/current/.venv/bin/python -m command_center.db self-deploy --repo-path ${AICC_SOURCE_REPO} --release-root /opt/aicc --release-venv ${AICC_RUNTIME_VENV} --migrate"
