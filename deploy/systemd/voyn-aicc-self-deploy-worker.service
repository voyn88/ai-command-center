# Worker-host self-deploy tick.
#
# Installed as /etc/systemd/system/voyn-aicc-self-deploy.service on worker
# hosts. Unlike the control host variant, this never runs migrations: the
# worker role has no DDL authority. It stages/selects /opt/aicc/releases/<sha>
# and then restarts worker lanes so the new code is picked up after drain.
[Unit]
Description=AICC worker self-deploy tick (merged -> immutable worker release)
After=network-online.target

[Service]
Type=oneshot
User=voynadmin
Environment=AICC_PREPROD_ROOT=/home/voynadmin/aicc-preprod
Environment=AICC_SOURCE_REPO=/opt/aicc/source
Environment=AICC_RUNTIME_VENV=/opt/aicc/runtime-venv
WorkingDirectory=/opt/aicc/source
# `[ -e ]` alone was the first version of this and it is the wrong test: a
# rollout killed outright (SIGKILL, OOM, power) never runs the `finally` that
# removes its lock, and an existence-only condition turns that one crash into
# a unit that is skipped every firing until the host reboots and clears the
# tmpfs. So the lock carries the rollout's pid and a holder that is gone is
# not a holder. Every other answer stays "held" (exit 1 = skipped, not
# failed): absent /proc entry aside, an unreadable lock or one whose contents
# are not a plain number defers, because deferring a tick that could have run
# costs one interval and running one that should have deferred costs the
# canceled systemd job this exists to prevent.
ExecCondition=/bin/sh -c 'lock=/run/aicc-staged-rollout.lock; [ -e "$$lock" ] || exit 0; holder=$$(cat "$$lock" 2>/dev/null) || exit 1; case "$$holder" in ""|*[!0-9]*|0*) exit 1 ;; esac; [ -d "/proc/$$holder" ] && exit 1; exit 0'
ExecStart=/bin/bash -lc "set -a && source ${AICC_PREPROD_ROOT}/worker.env && set +a && exec ${AICC_SOURCE_REPO}/.venv/bin/python -m command_center.db self-deploy --repo-path ${AICC_SOURCE_REPO} --release-root /opt/aicc --release-venv ${AICC_RUNTIME_VENV} --restart voyn-aicc-worker@1.service --restart voyn-aicc-worker@2.service --restart voyn-aicc-worker@3.service --restart voyn-aicc-worker@4.service"
