[Unit]
Description=AICC drain-safe worker credential rotation
After=network-online.target voyn-aicc-pgtunnel.service
Requires=voyn-aicc-pgtunnel.service
OnFailure=voyn-aicc-credential-rotation-alert@%n.service

[Service]
Type=oneshot
Restart=on-failure
RestartSec=2min
User=aicc-rotator
Group=aicc-worker
WorkingDirectory=/opt/aicc
StateDirectory=voyn-aicc-credential-rotation
StateDirectoryMode=0750
RuntimeDirectory=voyn-aicc-credential-rotation
RuntimeDirectoryMode=0750
PrivateTmp=true
ProtectSystem=strict
ExecStart=/opt/aicc/.venv/bin/python -m command_center.ops.credential_rotation --env-file /var/lib/voyn-aicc-credential-rotation/worker.env --lock-file /run/voyn-aicc-credential-rotation/rotation.lock --phase-file /var/lib/voyn-aicc-credential-rotation/phase.json --circuit-file /var/lib/voyn-aicc-credential-rotation/circuit.json --audit-file /var/lib/voyn-aicc-credential-rotation/audit.jsonl --tunnel-unit voyn-aicc-pgtunnel.service --tunnel-host 127.0.0.1 --tunnel-port 5433 --lane-registry /etc/voyn/aicc-worker-lanes.conf --prerequisite-timeout 120 --drain-timeout 180 --reload-timeout 180 --restart-timeout 3720 --controller-timeout 7200 --stop-budget 1140 --activation-cohort-size 8 --rotation-threshold 2100 --failure-retry-window 360 --circuit-failure-threshold 3 --circuit-cooldown 300
ExecStopPost=/opt/aicc/.venv/bin/python -m command_center.ops.credential_rotation --recover-only --env-file /var/lib/voyn-aicc-credential-rotation/worker.env --lock-file /run/voyn-aicc-credential-rotation/rotation.lock --phase-file /var/lib/voyn-aicc-credential-rotation/phase.json --circuit-file /var/lib/voyn-aicc-credential-rotation/circuit.json --audit-file /var/lib/voyn-aicc-credential-rotation/audit.jsonl --tunnel-unit voyn-aicc-pgtunnel.service --tunnel-host 127.0.0.1 --tunnel-port 5433 --lane-registry /etc/voyn/aicc-worker-lanes.conf --prerequisite-timeout 120 --drain-timeout 180 --reload-timeout 180 --restart-timeout 3720 --controller-timeout 7200 --stop-budget 1140 --activation-cohort-size 8 --rotation-threshold 2100 --failure-retry-window 360 --circuit-failure-threshold 3 --circuit-cooldown 300
TimeoutStartSec=7800s
TimeoutStopSec=1800s
