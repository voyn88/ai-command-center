[Unit]
Description=AICC drain-safe worker credential rotation
After=network-online.target voyn-aicc-pgtunnel.service
Requires=voyn-aicc-pgtunnel.service
OnFailure=voyn-aicc-credential-rotation-alert@%n.service

[Service]
Type=oneshot
Restart=on-failure
# 78 = misconfigured lane registry: only an operator edit clears it; a
# 2-minute restart loop would fire OnFailure alerting forever (review on
# fc0c391).
RestartPreventExitStatus=78
# Belt-and-suspenders alongside --rollout-lock in ExecStart: a tick already
# queued when the staged rollout stops this unit's timer would otherwise
# still run to completion. A skipped ExecCondition is not a failure (no
# OnFailure), matching the --rollout-lock deferral it backs up
# (VOYN-W0-AICC-ROLLOUT-VS-ROTATE-SELFDEPLOY-TIMERS).
#
# ExecStopPost below still runs when this condition skips the start
# (systemd.service(5): "ExecCondition= will also run the commands in
# ExecStopPost= ... in the case of any non-zero or abnormal exits"), which
# is exactly right: --recover-only is deliberately exempt from the rollout
# lock, because finishing an ALREADY-interrupted rotation beats leaving the
# fleet on an ambiguous credential until the rollout ends.
# `[ -e ]` alone was the first version of this and it is the wrong test: a
# rollout killed outright (SIGKILL, OOM, power) never runs the `finally` that
# removes its lock, and an existence-only condition turns that one crash into
# a unit that is skipped every firing until the host reboots and clears the
# tmpfs. So the lock carries the rollout's pid and a holder that is gone is
# not a holder. Every other answer stays "held" (exit 1 = skipped, not
# failed): absent /proc entry aside, an unreadable lock or one whose contents
# are not a plain number defers, because deferring a tick that could have run
# costs one interval and running one that should have deferred costs the
# canceled systemd job this exists to prevent.
ExecCondition=/bin/sh -c 'lock=/run/aicc-staged-rollout.lock; [ -e "$$lock" ] || exit 0; holder=$$(cat "$$lock" 2>/dev/null) || exit 1; case "$$holder" in ""|*[!0-9]*|0*) exit 1 ;; esac; [ -d "/proc/$$holder" ] && exit 1; exit 0'
RestartSec=2min
User=aicc-rotator
Group=aicc-worker
WorkingDirectory=/opt/aicc
StateDirectory=voyn-aicc-credential-rotation
StateDirectoryMode=0750
RuntimeDirectory=voyn-aicc-credential-rotation
RuntimeDirectoryMode=0750
PrivateTmp=true
ProtectSystem=strict
ExecStart=/opt/aicc/.venv/bin/python -m command_center.ops.credential_rotation --env-file /var/lib/voyn-aicc-credential-rotation/worker.env --lock-file /run/voyn-aicc-credential-rotation/rotation.lock --phase-file /var/lib/voyn-aicc-credential-rotation/phase.json --circuit-file /var/lib/voyn-aicc-credential-rotation/circuit.json --audit-file /var/lib/voyn-aicc-credential-rotation/audit.jsonl --tunnel-unit voyn-aicc-pgtunnel.service --tunnel-host 127.0.0.1 --tunnel-port 5433 --lane-registry /etc/voyn/aicc-worker-lanes.conf --prerequisite-timeout 120 --reload-timeout 180 --restart-timeout 3720 --controller-timeout 7200 --stop-budget 1140 --rotation-threshold 2100 --failure-retry-window 360 --circuit-failure-threshold 3 --circuit-cooldown 300 --rollout-lock /run/aicc-staged-rollout.lock
ExecStopPost=/opt/aicc/.venv/bin/python -m command_center.ops.credential_rotation --recover-only --env-file /var/lib/voyn-aicc-credential-rotation/worker.env --lock-file /run/voyn-aicc-credential-rotation/rotation.lock --phase-file /var/lib/voyn-aicc-credential-rotation/phase.json --circuit-file /var/lib/voyn-aicc-credential-rotation/circuit.json --audit-file /var/lib/voyn-aicc-credential-rotation/audit.jsonl --tunnel-unit voyn-aicc-pgtunnel.service --tunnel-host 127.0.0.1 --tunnel-port 5433 --lane-registry /etc/voyn/aicc-worker-lanes.conf --prerequisite-timeout 120 --reload-timeout 180 --restart-timeout 3720 --controller-timeout 7200 --stop-budget 1140 --rotation-threshold 2100 --failure-retry-window 360 --circuit-failure-threshold 3 --circuit-cooldown 300 --rollout-lock /run/aicc-staged-rollout.lock
TimeoutStartSec=7800s
TimeoutStopSec=1800s
