[Unit]
Description=AICC drain-safe worker credential rotation
After=network-online.target voyn-aicc-pgtunnel.service
Requires=voyn-aicc-pgtunnel.service
ConditionPathExists=/var/lib/voyn-aicc-credential-rotation/worker.env

[Service]
Type=oneshot
User=aicc-rotator
Group=aicc-worker
WorkingDirectory=/opt/aicc
StateDirectory=voyn-aicc-credential-rotation
StateDirectoryMode=0750
RuntimeDirectory=voyn-aicc-credential-rotation
RuntimeDirectoryMode=0750
PrivateTmp=true
ProtectSystem=strict
ExecStart=/opt/aicc/.venv/bin/python -m command_center.ops.credential_rotation --env-file /var/lib/voyn-aicc-credential-rotation/worker.env --lock-file /run/voyn-aicc-credential-rotation/rotation.lock --audit-file /var/lib/voyn-aicc-credential-rotation/audit.jsonl --tunnel-unit voyn-aicc-pgtunnel.service --tunnel-host 127.0.0.1 --tunnel-port 5433 --worker-unit voyn-aicc-worker@1.service --worker-unit voyn-aicc-worker@2.service --prerequisite-timeout 120 --drain-timeout 3660 --reload-timeout 180 --restart-timeout 3720 --controller-timeout 7200
TimeoutStartSec=7800s
