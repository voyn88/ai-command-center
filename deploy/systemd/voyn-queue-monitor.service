[Unit]
Description=VOYN durable queue fail-closed monitor
After=network-online.target tailscaled.service postgresql.service prometheus.service
Wants=network-online.target tailscaled.service postgresql.service prometheus.service

[Service]
Type=oneshot
User=voynadmin
WorkingDirectory=/home/voynadmin/aicc-preprod/repo
EnvironmentFile=/home/voynadmin/aicc-preprod/.env
# --pr-window-repo runs one `gh pr list` per tick and turns "an open fleet PR
# has carried no review-window label for over 15 minutes" into a monitor
# finding. It belongs to this probe and not the worker one: it needs the
# backlog database (the `pr` evidence) and the control host's gh identity.
# Without it, a PR-window reconciler that is absent, disabled, failing or out
# of GitHub quota is invisible -- which is how every fleet PR went without CI
# until 2026-09-09 (VOYN-W0-AICC-PR-WINDOW-RECONCILER-NOT-DEPLOYED-ON-CONTROL).
# It is enabled by AICC_PR_WINDOW_REPO below rather than by a flag: this
# unit's ExecStart names an absolute home path, which a public repository
# cannot restate in a new line (scripts/ci/prepush/leak_guard.sh), and an
# environment default is the same knob either way. `.` is this unit's own
# WorkingDirectory above -- a clone, so gh reads the repository from its
# remote. The finding reaches the planner through this unit's
# --record-findings source, exactly like every other failure class.
Environment=AICC_PR_WINDOW_REPO=.
# The other half of the same question, asked directly: are the repo-owned
# control ticks actually SCHEDULED on this host? The probe above measures the
# reconciler by its EFFECT, so it can only speak once unlabelled fleet PRs
# exist and only after their grace period -- on a quiet fleet a timer that was
# never installed stays invisible right up to the moment PRs appear.
# control-01 ran no PR-window timer at all for over a day while 67 open PRs
# (752-822) went unlabelled and operators labelled them by hand
# (VOYN-W0-AICC-PR-WINDOW-TIMER-NOT-DEPLOYED-ON-CONTROL); the host-wide unit
# probe could not see it, because it asks systemd only for `--type=service`
# and a timer that was never installed is not a failed service -- it is
# nothing at all. This is the control probe and not the worker one for the
# same reason as the line above: a worker host runs none of these timers and
# their absence there is correct. Turned on by the environment rather than a
# flag for the same reason as AICC_PR_WINDOW_REPO: the ExecStart below names
# an absolute home path, which a public repository cannot restate in a new
# line (scripts/ci/prepush/leak_guard.sh).
Environment=AICC_CONTROL_TIMERS=1
ExecStart=/home/voynadmin/aicc-preprod/repo/.venv/bin/python -m command_center.ops.infra_monitor --skip-workers --minimum-active-workers 0 --max-stalled-seconds 900 --max-recent-dead 0 --prometheus-url http://100.114.209.119:9090/-/ready
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
