[Unit]
Description=VOYN durable queue fail-closed monitor
After=network-online.target tailscaled.service postgresql.service prometheus.service
Wants=network-online.target tailscaled.service postgresql.service prometheus.service

[Service]
Type=oneshot
User=voynadmin
WorkingDirectory=/home/voynadmin/aicc-preprod/repo
EnvironmentFile=/home/voynadmin/aicc-preprod/.env
ExecStart=/home/voynadmin/aicc-preprod/repo/.venv/bin/python -m command_center.ops.infra_monitor --skip-workers --minimum-active-workers 0 --max-stalled-seconds 900 --prometheus-url http://100.114.209.119:9090/-/ready
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
