# Installed as /etc/sudoers.d/voyn-aicc-credential-rotation (root:root 0440).
# Exact argv only: the rotator cannot operate on arbitrary systemd units.
Cmnd_Alias VOYN_AICC_ROTATION = \
 /usr/bin/systemctl show voyn-aicc-pgtunnel.service --property=ActiveState\,SubState\,StatusText\,MainPID --no-pager, \
 /usr/bin/systemctl show voyn-aicc-worker@1.service --property=ActiveState\,SubState\,StatusText\,MainPID --no-pager, \
 /usr/bin/systemctl show voyn-aicc-worker@2.service --property=ActiveState\,SubState\,StatusText\,MainPID --no-pager, \
 /usr/bin/systemctl kill --kill-whom=main --signal=SIGUSR1 voyn-aicc-worker@1.service, \
 /usr/bin/systemctl kill --kill-whom=main --signal=SIGUSR1 voyn-aicc-worker@2.service, \
 /usr/bin/systemctl reload voyn-aicc-worker@1.service, \
 /usr/bin/systemctl reload voyn-aicc-worker@2.service, \
 /usr/bin/systemctl restart voyn-aicc-worker@1.service, \
 /usr/bin/systemctl restart voyn-aicc-worker@2.service
aicc-rotator ALL=(root) NOPASSWD: VOYN_AICC_ROTATION
