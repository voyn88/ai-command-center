# Installed as /etc/sudoers.d/voyn-aicc-credential-rotation (root:root 0440).
# The rotator may run only the root-owned rotation helper, one verb at a time.
# Unit authorization lives in the helper's root-owned lane registry
# (/etc/voyn/aicc-worker-lanes.conf), not in enumerated sudoers lines, so the
# fleet scales to any lane count without touching sudo policy.
Cmnd_Alias VOYN_AICC_ROTATION = \
 /usr/local/sbin/voyn-aicc-rotation-helper show *, \
 /usr/local/sbin/voyn-aicc-rotation-helper drain *, \
 /usr/local/sbin/voyn-aicc-rotation-helper reload *, \
 /usr/local/sbin/voyn-aicc-rotation-helper restart *
aicc-rotator ALL=(root) NOPASSWD: VOYN_AICC_ROTATION
