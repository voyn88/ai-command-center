{
  "$meta": {
    "name": "control-plane-design-tokens",
    "version": "1.0.0",
    "description": "Canonical design tokens for the operator dashboard. Single source of truth for the desktop web shell and the mobile app. Dark-first, electric-indigo accent, ink-slate ground, depth over borders.",
    "themes": ["dark", "light"],
    "default_theme": "dark",
    "rule": "No hardcoded colors anywhere downstream. Consume tokens only."
  },
  "color": {
    "bg":       { "dark": "#0B0E14", "light": "#F4F6FB" },
    "surface":  { "dark": "#121724", "light": "#FFFFFF" },
    "raise":    { "dark": "#1A2130", "light": "#FBFCFF" },
    "hairline": { "dark": "rgba(255, 255, 255, 0.08)", "light": "rgba(16, 22, 40, 0.10)" },
    "line":     { "dark": "#2A3441", "light": "#D7DEE9" },
    "text":     { "dark": "#E8ECF4", "light": "#10151F" },
    "text-2":   { "dark": "#A6B0C3", "light": "#515A6B" },
    "text-3":   { "dark": "#6B7488", "light": "#8A93A6" },
    "accent":   { "dark": "#6C8CFF", "light": "#4C6EF0" },
    "accent-2": { "dark": "#536DFE", "light": "#3B54D6" },
    "ok":       { "dark": "#3DDC97", "light": "#1FA971" },
    "warn":     { "dark": "#F5B14C", "light": "#C8811A" },
    "crit":     { "dark": "#FF6B7A", "light": "#E23D4E" },
    "violet":   { "dark": "#B08CFF", "light": "#7A4DE0" },
    "cyan":     { "dark": "#55D6E3", "light": "#1699A8" }
  },
  "shadow": {
    "sh":    { "dark": "0 1px 2px rgba(0, 0, 0, 0.40), 0 4px 16px rgba(0, 0, 0, 0.35)", "light": "0 1px 2px rgba(16, 22, 40, 0.06), 0 4px 16px rgba(16, 22, 40, 0.08)" },
    "sh-hi": { "dark": "0 8px 30px rgba(0, 0, 0, 0.50)", "light": "0 12px 34px rgba(16, 22, 40, 0.14)" }
  },
  "typography": {
    "font": {
      "sans": "-apple-system, \"SF Pro Text\", system-ui, sans-serif",
      "mono": "\"SF Mono\", \"JetBrains Mono\", ui-monospace, monospace"
    },
    "size": {
      "xs":   "11px",
      "sm":   "12px",
      "base": "13px",
      "md":   "14px",
      "lg":   "16px",
      "xl":   "20px",
      "2xl":  "28px",
      "3xl":  "36px"
    },
    "weight": {
      "regular":  "400",
      "medium":   "500",
      "semibold": "600",
      "bold":     "700"
    },
    "tracking": {
      "tight":  "-0.01em",
      "normal": "0",
      "wide":   "0.02em",
      "caps":   "0.06em"
    }
  },
  "space": {
    "px": "2px",
    "1":  "4px",
    "2":  "8px",
    "3":  "12px",
    "4":  "16px",
    "5":  "20px",
    "6":  "24px",
    "8":  "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },
  "radius": {
    "sm":   "6px",
    "md":   "10px",
    "lg":   "14px",
    "xl":   "20px",
    "pill": "999px"
  },
  "motion": {
    "duration": {
      "fast": "120ms",
      "base": "200ms",
      "slow": "320ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0.7, 0.2, 1)"
    }
  }
}
